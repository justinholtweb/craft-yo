{
    "name": "justinholtweb/craft-yo",
    "description": "A flash-message bus for Craft CMS plugins. One API, an events surface other plugins can hook, a floating control-panel panel, and unstyled front-end markup you own.",
    "version": "5.1.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "flash",
        "notifications",
        "messages",
        "toast",
        "events",
        "datastar",
        "developer-tools"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "issues": "https://github.com/justinholtweb/craft-yo/issues",
        "source": "https://github.com/justinholtweb/craft-yo"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\yo\\": "src/"
        }
    },
    "extra": {
        "handle": "yo",
        "name": "Yo",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-yo/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-yo/main/CHANGELOG.md",
        "description": "A flash-message bus other plugins can talk to.",
        "class": "justinholtweb\\yo\\Plugin",
        "hasCpSettings": true,
        "hasCpSection": false
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
