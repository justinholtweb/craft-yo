{# The floating panel.

   Rendered once per control panel page, at the end of the body — see `Plugin::registerCpPanel()`
   for why it cannot live inside `#content`.

   The shell is DataStar's: open/closed, the count, and whether there is anything to show are all
   signals, so a server patch can change any of them without this template knowing how. The only
   thing `yo-cp.js` owns is dragging, because that is a pointer gesture and not a state machine. #}
{% import 'yo/_mascot' as mascot %}

{% set csrf = "{headers: {'X-CSRF-Token': window.YoConfig.csrfTokenValue}}" %}
{% set pollUrl = actionUrl('yo/stream/poll') %}
{% set count = messages|length %}

<div id="yo-panel"
     class="yo-panel yo-panel--{{ config.position }}"
     data-yo-panel
     data-yo-position="{{ config.position }}"
     data-yo-auto-dismiss="{{ config.autoDismissAfter }}"
     data-signals="{yoOpen: {{ count > 0 ? 'true' : 'false' }}, yoCount: {{ count }}, yoHasMessages: {{ count > 0 ? 'true' : 'false' }}}"
     {% if not config.idleMascot %}data-show="$yoHasMessages"{% endif %}>

    <div class="yo-set">
        <div class="yo-set__antenna" aria-hidden="true">
            <svg viewBox="0 0 60 26"><path d="M30 26 12 3M30 26l18-23" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="12" cy="3" r="3"/><circle cx="48" cy="3" r="3"/></svg>
        </div>

        <header class="yo-bar" data-yo-drag>
            <span class="yo-bar__mascot" data-yo-mascot>
                {{ mascot.alien('idle', 30) }}
            </span>
            <span class="yo-bar__name">{{ 'Yo'|t('yo') }}</span>
            <span class="yo-bar__count" data-yo-count data-text="$yoCount" data-show="$yoHasMessages">{{ count }}</span>

            {% hook 'yo.panel.header' %}

            <span class="yo-bar__tools">
                <button type="button" class="yo-icon-btn" data-yo-move-toggle
                        title="{{ 'Move the panel'|t('yo') }}" aria-label="{{ 'Move the panel'|t('yo') }}">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5v13M1.5 8h13M8 1.5 5.5 4M8 1.5 10.5 4M8 14.5 5.5 12M8 14.5 10.5 12M1.5 8 4 5.5M1.5 8 4 10.5M14.5 8 12 5.5M14.5 8 12 10.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <button type="button" class="yo-icon-btn" data-on-click="$yoOpen = !$yoOpen"
                        title="{{ 'Collapse'|t('yo') }}" aria-label="{{ 'Collapse'|t('yo') }}">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 6.5 8 11l4.5-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </span>
        </header>

        {# Six anchors rather than free positioning. A dragged panel snaps to the nearest, so the
           position is a thing that can be stored, described and set from the keyboard — none of
           which is true of a pair of pixel offsets. #}
        <div class="yo-move" data-yo-move-menu hidden>
            {% for value, label in {
                'top-left': 'Top left'|t('yo'),
                'top-center': 'Top centre'|t('yo'),
                'top-right': 'Top right'|t('yo'),
                'bottom-left': 'Bottom left'|t('yo'),
                'bottom-center': 'Bottom centre'|t('yo'),
                'bottom-right': 'Bottom right'|t('yo'),
            } %}
                <button type="button" class="yo-move__spot{{ config.position == value ? ' yo-move__spot--on' }}"
                        data-yo-position-choice="{{ value }}"
                        data-on-click="@post('{{ actionUrl('yo/stream/position', { position: value }) }}', {{ csrf }})">{{ label }}</button>
            {% endfor %}
        </div>

        <div class="yo-screen" data-show="$yoOpen">
            <div class="yo-screen__scan" aria-hidden="true"></div>

            <div id="yo-messages" class="yo-messages" role="log" aria-live="polite" aria-relevant="additions">
                {{ include('yo/_panel-messages', { messages: messages }) }}
            </div>

            <footer class="yo-foot">
                <button type="button" class="yo-foot__clear" data-show="$yoHasMessages"
                        data-on-click="@post('{{ actionUrl('yo/stream/clear') }}', {{ csrf }})">{{ 'Clear them all'|t('yo') }}</button>
                <span class="yo-foot__hook">{% hook 'yo.panel.footer' %}</span>
            </footer>
        </div>
    </div>

    {% if config.pollInterval > 0 %}
        {# The one long-running thing on the page, and it is a poll rather than a held-open stream
           on purpose: an SSE connection per open control panel tab occupies a PHP-FPM worker for
           as long as the tab is open, and a busy editorial team would exhaust the pool with
           nobody doing anything wrong. #}
        <div hidden data-yo-poller data-on-interval__duration.{{ config.pollInterval }}s="@get('{{ pollUrl }}')"></div>
    {% endif %}
</div>
